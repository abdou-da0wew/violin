{
  "name": "@abdou-da0wew/violin",
  "version": "0.1.0",
  "description": "Violin: a fast, structured logger and application error toolkit for Node.js and Bun, with a Fastify/Pino-compatible adapter.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.4",
  "keywords": [
    "violin",
    "logger",
    "structured-logging",
    "fastify",
    "pino-compatible",
    "observability",
    "typescript",
    "bun",
    "transports",
    "app-error"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors/index.d.ts",
        "default": "./dist/errors/index.js"
      },
      "require": {
        "types": "./dist/errors/index.d.cts",
        "default": "./dist/errors/index.cjs"
      }
    },
    "./transports": {
      "import": {
        "types": "./dist/transports/index.d.ts",
        "default": "./dist/transports/index.js"
      },
      "require": {
        "types": "./dist/transports/index.d.cts",
        "default": "./dist/transports/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/fastify.ts src/errors/index.ts src/transports/index.ts --format esm,cjs --dts --clean --sourcemap --target node20 --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepack": "bun run typecheck && bun run test && bun run build",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "fastify": ">=4 <6"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22.0.0",
    "fastify": "^5.8.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Abdou <210929342+abdou-da0wew@users.noreply.github.com>",
  "homepage": "https://github.com/abdou-da0wew/violin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdou-da0wew/violin.git"
  },
  "bugs": {
    "url": "https://github.com/abdou-da0wew/violin/issues"
  }
}
